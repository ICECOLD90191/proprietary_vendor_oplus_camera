app_domain(opluscamera_app)
net_domain(opluscamera_app)

# Camera HAL
binder_call(opluscamera_app, hal_camera_default)
binder_call(hal_camera_default, opluscamera_app)
hwbinder_use(opluscamera_app)

# APS encodes through the HW JPEG service hosted by the camera provider.
typeattribute opluscamera_app halclientdomain;
typeattribute opluscamera_app hal_camera_client;

# Adreno driver
hal_client_domain(opluscamera_app, vendor_hal_qspmhal)

# DSP
typeattribute opluscamera_app vendor_hal_dspmanager_client;
allow opluscamera_app adsprpcd_file:dir r_dir_perms;
allow opluscamera_app { adsprpcd_file public_adsprpcd_file }:file r_file_perms;
allow opluscamera_app vendor_qdsp_device:chr_file { ioctl read };
get_prop(opluscamera_app, vendor_adsprpc_prop)

# ArcSoft HDR offloads to a signed DSP process through the secure FastRPC node.
allow opluscamera_app vendor_secure_fastrpc_device:chr_file r_file_perms;

# Vendor data
allow opluscamera_app { vendor_camera_data_file vendor_camera_update_data_file vendor_data_file }:dir create_dir_perms;
allow opluscamera_app { vendor_camera_data_file vendor_camera_update_data_file vendor_data_file }:file create_file_perms;

# Stock libraries loaded directly by the app. The private policy marks this
# domain as system_executes_vendor_violators for these.
allow opluscamera_app vendor_file:dir r_dir_perms;
allow opluscamera_app vendor_file:file { r_file_perms execute };
allow opluscamera_app same_process_hal_file:file { r_file_perms execute };

# Properties
get_prop(opluscamera_app, camera_config_prop)
get_prop(opluscamera_app, vendor_camera_prop)

# Services
allow opluscamera_app activity_service:service_manager find;
allow opluscamera_app display_service:service_manager find;
allow opluscamera_app hal_system_suspend_service:service_manager find;
allow opluscamera_app package_native_service:service_manager find;
allow opluscamera_app permission_service:service_manager find;
allow opluscamera_app surfaceflinger_service:service_manager find;

# Misc
allow opluscamera_app cgroup_v2:dir search;
allow opluscamera_app proc_ufs_file:file r_file_perms;
allow opluscamera_app property_socket:sock_file write;
