From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: inferno0230 <mail@inferno0230.in>
Subject: [PATCH 4/4] gallery: Enable Live Photos

---
diff --git a/smali/com/oplus/aiunit/vision/u9a.smali b/smali/com/oplus/aiunit/vision/u9a.smali
index 797efaf..19df6a9 100644
--- a/smali/com/oplus/aiunit/vision/u9a.smali
+++ b/smali/com/oplus/aiunit/vision/u9a.smali
@@ -197,6 +197,47 @@
     .annotation runtime Lkotlin/jvm/JvmStatic;
     .end annotation
 
+    # Report the Olive features as supported, stock sets them from the build config
+    const-string v0, "feature_is_support_olive"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-nez v0, :cond_olive_enabled
+
+    const-string v0, "feature_is_support_olive_slide_play"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-nez v0, :cond_olive_enabled
+
+    const-string v0, "feature_is_support_video_extract_olive"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-nez v0, :cond_olive_enabled
+
+    const-string v0, "feature_olive_slow_motion_recommend_popup_shown"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-nez v0, :cond_olive_enabled
+
+    goto :goto_olive_skip
+
+    :cond_olive_enabled
+    const/4 v0, 0x1
+
+    return v0
+
+    :goto_olive_skip
     .line 1
     const-string v0, "configId"
 
